# Copy this file to a new file named ".env" and fill it in. NEVER commit ".env".
#
# Pick ONE provider by setting LLM_PROVIDER, and fill in only that section.

# ---------------------------------------------------------------------------
# Option 1 (default): OpenRouter, free NVIDIA model.  Free key: https://openrouter.ai/keys
# Free models have a daily request limit. When it is used up, switch to option 2 or 3.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# ---------------------------------------------------------------------------
# Option 2: any other provider that copies OpenAI's API (LLM_PROVIDER=custom).
# These providers have their own, separate free limits. Examples:
#
#   Groq (free tier, key at https://console.groq.com/keys)
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#
#   Google Gemini (free tier, key at https://aistudio.google.com/apikey)
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     LLM_MODEL=gemini-2.0-flash
#
# Model names change over time. Check the provider's model list if you get a "model not found" error.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_provider_api_key
# LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Option 3: OpenAI (paid)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini
